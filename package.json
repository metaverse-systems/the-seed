{
  "name": "@metaverse-systems/the-seed",
  "version": "2.0.0",
  "description": "The Seed",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Build": {
      "types": "./dist/Build.d.ts",
      "default": "./dist/Build.js"
    },
    "./Config": {
      "types": "./dist/Config.d.ts",
      "default": "./dist/Config.js"
    },
    "./Dependencies": {
      "types": "./dist/Dependencies.d.ts",
      "default": "./dist/Dependencies.js"
    },
    "./DependencyWalker": {
      "types": "./dist/DependencyWalker.d.ts",
      "default": "./dist/DependencyWalker.js"
    },
    "./Hints": {
      "types": "./dist/cli/Hints.d.ts",
      "default": "./dist/cli/Hints.js"
    },
    "./Installer": {
      "types": "./dist/Installer.d.ts",
      "default": "./dist/Installer.js"
    },
    "./NativeComponent": {
      "types": "./dist/NativeComponent.d.ts",
      "default": "./dist/NativeComponent.js"
    },
    "./Package": {
      "types": "./dist/Package.d.ts",
      "default": "./dist/Package.js"
    },
    "./ProjectError": {
      "types": "./dist/ProjectError.d.ts",
      "default": "./dist/ProjectError.js"
    },
    "./RecursiveBuild": {
      "types": "./dist/RecursiveBuild.d.ts",
      "default": "./dist/RecursiveBuild.js"
    },
    "./ResourcePak": {
      "types": "./dist/ResourcePak.d.ts",
      "default": "./dist/ResourcePak.js"
    },
    "./Scopes": {
      "types": "./dist/Scopes.d.ts",
      "default": "./dist/Scopes.js"
    },
    "./Signing": {
      "types": "./dist/Signing.d.ts",
      "default": "./dist/Signing.js"
    },
    "./Template": {
      "types": "./dist/Template.d.ts",
      "default": "./dist/Template.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "node scripts/run-checks.js typecheck",
    "lint": "node scripts/run-checks.js lint",
    "lint-fix": "node ./node_modules/eslint/bin/eslint.js --ext .ts src test --fix",
    "build": "tsc && node -e \"require('fs').chmodSync('dist/scripts/the-seed.js', 0o755)\"",
    "build-addon": "node native/build.js",
    "install": "node native/build.js --install",
    "prepare": "npm run build",
    "prepack": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "node scripts/run-checks.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaverse-systems/the-seed.git"
  },
  "author": "Tim Schwartz <tim@metaverse.systems>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/metaverse-systems/the-seed/issues"
  },
  "homepage": "https://github.com/metaverse-systems/the-seed#readme",
  "dependencies": {
    "@peculiar/asn1-cms": "^2.6.1",
    "@peculiar/asn1-schema": "^2.6.0",
    "@peculiar/asn1-x509": "^2.6.1",
    "@peculiar/x509": "^1.14.3",
    "asn1js": "^3.0.7",
    "fs-extra": "^10.0.1",
    "inquirer": "^8.2.2",
    "isbinaryfile": "^5.0.7",
    "node-addon-api": "^5.0.0",
    "tslib": "^2.3.1"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "templates/",
    "CHANGELOG.md",
    "native/binding.gyp",
    "native/src/",
    "native/build.js",
    "native/pkg-config.js"
  ],
  "bin": {
    "the-seed": "dist/scripts/the-seed.js"
  },
  "keywords": [],
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^8.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^5.15.0",
    "@typescript-eslint/parser": "^5.15.0",
    "eslint": "^8.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
